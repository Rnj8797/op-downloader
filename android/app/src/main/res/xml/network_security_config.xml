<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Strictly disallow all cleartext HTTP traffic -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Production API Domain configuration with TLS 1.3 -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.opdownloader.app</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
