# ==============================================================================
# OP Downloader - Environment Configuration Template
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
APP_PORT=8000
APP_SECRET_KEY=change_this_to_a_random_64_character_hex_string_in_production

# PostgreSQL Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=op_downloader
POSTGRES_USER=op_app_user
POSTGRES_PASSWORD=generate_a_secure_database_password_here
DATABASE_URL=postgresql+asyncpg://op_app_user:generate_a_secure_database_password_here@postgres:5432/op_downloader

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=generate_a_secure_redis_password_here
REDIS_URL=redis://:generate_a_secure_redis_password_here@redis:6379/0

# JWT Authentication
JWT_SECRET=generate_a_secure_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Rate Limiting Configuration
RATE_LIMIT_ANONYMOUS_HOURLY=10
RATE_LIMIT_AUTHENTICATED_HOURLY=50
MAX_CONCURRENT_DOWNLOADS_PER_USER=2

# Security & Storage Limits
MAX_DOWNLOAD_SIZE_BYTES=2147483648  # 2 GB limit
SCRATCH_STORAGE_DIR=/var/media_scratch
SCRATCH_TTL_MINUTES=60
ALLOWED_CORS_ORIGINS=["https://opdownloader.app"]
